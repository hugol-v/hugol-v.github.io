---
layout: default
---
<div class="post home-page">
  <article>
    {% if page.profile %}
      <section
        class="home-profile-panel{% if page.profile.image or page.profile.more_info %} home-profile-panel--has-media home-profile-panel--media-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}{% endif %}"
        aria-labelledby="home-profile-title"
      >
        {% if page.profile.image or page.profile.more_info %}
          <div class="home-profile-media">
            {% if page.profile.image %}
              {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
              {% if page.profile.image_circular %}
                {% assign profile_image_class = 'home-profile-image img-fluid rounded-circle' %}
              {% else %}
                {% assign profile_image_class = 'home-profile-image img-fluid' %}
              {% endif %}
              {% capture profile_image_alt %}Portrait of {% if site.title == 'blank' %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% else %}{{ site.title }}{% endif %}{% endcapture %}
              {% capture sizes %}(min-width: {{ site.max_width }}) 230px, (min-width: 768px) 28vw, 72vw{% endcapture %}
              <div class="home-profile-image-frame{% if page.profile.image_circular %} home-profile-image-frame--circular{% endif %}">
                {%
                  include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes
                  alt=profile_image_alt cache_bust=true
                %}
              </div>
            {% endif %}
            {% if page.profile.more_info %}
              <div class="home-profile-meta">{{ page.profile.more_info }}</div>
            {% endif %}
          </div>
        {% endif %}

        <div class="home-profile-content">
          <header class="home-profile-header">
            <h1 id="home-profile-title" class="post-title">
              {% if site.title == 'blank' %}
                <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
                {{ site.last_name }}
              {% else %}
                {{ site.title }}
              {% endif %}
            </h1>
            <p class="desc">{{ page.subtitle }}</p>
          </header>

          <div class="home-profile-introduction">{{ content }}</div>
        </div>
      </section>
    {% else %}
      <header class="post-header">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <p class="desc">{{ page.subtitle }}</p>
      </header>

      <div class="clearfix">{{ content }}</div>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2 class="home-section-heading">
        <a href="{{ '/news/' | relative_url }}">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="home-section-heading">
        <a href="{{ '/publications/' | relative_url }}">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
