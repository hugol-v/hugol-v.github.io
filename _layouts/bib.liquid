---
---
{% assign entry_has_media = false %}
{% unless page.presentation_bibliography %}
  {% if site.enable_publication_thumbnails %}
    {% if entry.abbr or entry.preview %}
      {% assign entry_has_media = true %}
    {% endif %}
  {% endif %}
{% endunless %}
<article class="publication-entry{% if entry_has_media %} publication-entry--has-media{% if entry.preview %} publication-entry--has-preview{% endif %}{% else %} publication-entry--no-media{% endif %}{% if page.presentation_bibliography %} presentation-entry{% if entry.preview %} presentation-entry--has-preview{% endif %}{% endif %}">

  <!-- Entry bib key -->
  <div id="{{entry.key}}" class="publication-content">
    <!-- Title -->
    {% if page.presentation_bibliography %}
      <div class="presentation-entry-heading">
        <div class="title">{{ entry.title }}</div>
        {% unless entry.preview %}
          {% if entry.presentationtype %}
            <span class="presentation-type">{{ entry.presentationtype }}</span>
          {% endif %}
        {% endunless %}
      </div>
    {% else %}
      <div class="title">{{ entry.title }}</div>
    {% endif %}
    <!-- Author -->
    <div class="author">
      {% assign author_array_size = entry.author_array | size %}
      {% assign author_array_limit = author_array_size %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign author_array_limit = site.max_author_limit %}
      {% endif %}
      {% assign more_authors = author_array_size | minus: author_array_limit %}

      <span class="author-list-primary">
      {%- for author in entry.author_array limit: author_array_limit -%}
        {%- unless forloop.first -%}
          {%- if more_authors == 0 and forloop.last -%}
            {%- if forloop.length == 2 -%}
              &nbsp;and&nbsp;
            {%- else -%}
              ,&nbsp;and&nbsp;
            {%- endif -%}
          {%- else -%}
            ,&nbsp;
          {%- endif -%}
        {%- endunless -%}
        {%- include bib_author.liquid author=author -%}
      {% endfor %}
      </span>

      {% if more_authors > 0 %}
        {%- assign more_authors_label = more_authors | append: ' more author' -%}
        {%- if more_authors > 1 -%}
          {%- assign more_authors_label = more_authors_label | append: 's' -%}
        {%- endif -%}
        {%- capture author_list_id -%}{{ entry.key | slugify }}-additional-authors{%- endcapture -%}
        <span class="author-list-summary"
          >,&nbsp;and&nbsp;<button
            class="author-list-expand"
            type="button"
            aria-expanded="false"
            aria-controls="{{ author_list_id }}"
            aria-label="Show {{ more_authors_label }}"
          >
            {{- more_authors }} more</button
          ></span
        >
        <span id="{{ author_list_id }}" class="additional-authors" hidden aria-hidden="true">
        {%- for author in entry.author_array offset: author_array_limit -%}
          {%- if forloop.last -%},&nbsp;and&nbsp;{%- else -%},&nbsp;{%- endif -%}
          {%- include bib_author.liquid author=author -%}
        {%- endfor -%}
          <button class="author-list-collapse" type="button" aria-label="Collapse author list" title="Collapse author list">
            <i class="ti ti-chevron-up" aria-hidden="true"></i>
          </button>
        </span>
      {% endif %}
    </div>

    <!-- Journal/Book title and date -->
    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
    {% if entry.type == 'article' %}
      {% capture entrytype %}<em>{{entry.journal}}</em>{% endcapture %}
    {% elsif proceedings contains entry.type %}
      {% capture entrytype %}<em>In {{entry.booktitle}}</em> {% endcapture %}
    {% elsif thesis contains entry.type %}
      {% capture entrytype %}<em>{{entry.school}}</em> {% endcapture %}
    {% else %}
      {% capture entrytype %}{% endcapture %}
    {% endif %}
    {% if entry.month %}
      {% capture entrymonth %}{{ " " }}{{ entry.month | capitalize }}{% endcapture %}
    {% endif %}
    {% if entry.year %}
      {% capture entryyear %}{{ " " }}{{entry.year}}{% endcapture %}
    {% endif %}
    {% if entry.location %}
      {% capture entrytype %}{{entrytype}}{{ ", " }}{{entry.location}}{% endcapture %}
    {% endif -%}
    {% if entry.additional_info %}
      {% capture entrytype %}{{entrytype}}{{entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' }}{% endcapture %}
    {% endif %}
    {% capture hook_exists %}{% file_exists _includes/hook/bib.liquid %}{% endcapture %}
    {% if hook_exists == 'true' %}
      {% include hook/bib.liquid %}
    {% endif %}
    {% assign entrytype_text = entrytype | strip_html | strip %}
    {% capture periodical %}{{ entrytype }}{% if entrytype_text != "" and entryyear != "" %}, {% endif %}{{ entrymonth }}{{ entryyear }}{% endcapture %}
    <div class="periodical">
      {{ periodical | strip }}
    </div>
    <div class="periodical">
      {{ entry.note | strip }}
    </div>

    <!-- Links/Buttons -->
    <div class="links">
      {% if entry.award %}
        <button
          class="award btn btn-sm z-depth-0"
          type="button"
          aria-expanded="false"
          aria-controls="{{ entry.key }}-award"
        >
          {%- if entry.award_name %}{{ entry.award_name }}{% else %}Award{% endif -%}
        </button>
      {% endif %}
      {% if entry.abstract %}
        <button
          class="abstract btn btn-sm z-depth-0"
          type="button"
          aria-expanded="false"
          aria-controls="{{ entry.key }}-abstract"
        >
          Abstract
        </button>
      {% endif %}
      {% if entry.arxiv %}
        <a href="http://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0" role="button">arXiv</a>
      {% endif %}
      {% if entry.bibtex_show %}
        <button
          class="bibtex btn btn-sm z-depth-0"
          type="button"
          aria-expanded="false"
          aria-controls="{{ entry.key }}-bibtex"
        >
          BibTeX
        </button>
      {% endif %}
      {% if entry.html %}
        {% if entry.html contains '://' %}
          <a href="{{ entry.html }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
        {% else %}
          <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
        {% endif %}
      {% endif %}
      {% if entry.article %}
        {% if entry.article contains '://' %}
          <a href="{{ entry.article }}" class="btn btn-sm z-depth-0" role="button">Article</a>
        {% else %}
          <a href="{{ entry.article | prepend: '/assets/article/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Article</a>
        {% endif %}
      {% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.supp %}
        {% if entry.supp contains '://' %}
          <a href="{{ entry.supp }}" class="btn btn-sm z-depth-0" role="button">Supp</a>
        {% else %}
          <a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Supp</a>
        {% endif %}
      {% endif %}
      {% if entry.video and site.enable_video_embedding %}
        <button
          class="video-toggle btn btn-sm z-depth-0"
          type="button"
          aria-expanded="false"
          aria-controls="{{ entry.key }}-video"
        >
          Video
        </button>
      {% elsif entry.video %}
        <a href="{{ entry.video }}" class="btn btn-sm z-depth-0" role="button">Video</a>
      {% endif %}
      {% if entry.blog %}
        <a href="{{ entry.blog }}" class="btn btn-sm z-depth-0" role="button">Blog</a>
      {% endif %}
      {% if entry.code %}
        <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
      {% endif %}
      {% if entry.poster %}
        {% if entry.poster contains '://' %}
          <a href="{{ entry.poster }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% else %}
          <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% endif %}
      {% endif %}
      {% if entry.notes %}
        {% if entry.notes contains '://' %}
          <a href="{{ entry.notes }}" class="btn btn-sm z-depth-0" role="button">Notes</a>
        {% else %}
          <a href="{{ entry.notes | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Notes</a>
        {% endif %}
      {% endif %}
      {% if entry.slides %}
        {% if entry.slides contains '://' %}
          <a href="{{ entry.slides }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% else %}
          <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% endif %}
      {% endif %}
      {% if entry.website %}
        <a href="{{ entry.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
      {% endif %}
    </div>
    {% if site.enable_publication_badges %}
      {% assign entry_has_altmetric_badge = false %}
      {% if entry.altmetric or entry.doi or entry.arxiv or entry.pmid or entry.isbn %}
        {% assign entry_has_altmetric_badge = true %}
      {% endif %}
      {% assign entry_has_dimensions_badge = false %}
      {% if entry.dimensions or entry.doi or entry.pmid %}
        {% assign entry_has_dimensions_badge = true %}
      {% endif %}
      {% assign entry_has_google_scholar_badge = entry.google_scholar_id %}
      {% if entry_has_altmetric_badge or entry_has_dimensions_badge or entry_has_google_scholar_badge %}
        <div class="badges">
          {% if site.enable_publication_badges.altmetric and entry_has_altmetric_badge %}
            <span
              class="altmetric-embed"
              data-hide-no-mentions="true"
              data-hide-less-than="15"
              data-badge-type="2"
              data-badge-popover="right"
              {% if entry.arxiv %}
                data-arxiv-id="{{ entry.arxiv }}"
              {% elsif entry.doi %}
                data-doi="{{ entry.doi }}"
              {% elsif entry.altmetric %}
                data-altmetric-id="{{ entry.altmetric }}"
              {% elsif entry.pmid %}
                data-pmid="{{ entry.pmid }}"
              {% elsif entry.isbn %}
                data-isbn="{{ entry.isbn }}"
              {% endif %}
            ></span>
          {% endif %}
          {% if site.enable_publication_badges.dimensions and entry_has_dimensions_badge %}
            <span
              class="__dimensions_badge_embed__"
              {% if entry.doi %}
                data-doi="{{ entry.doi }}"
              {% elsif entry.pmid %}
                data-pmid="{{ entry.pmid }}"
              {% else %}
                data-id="{{ entry.dimensions }}"
              {% endif %}
              data-hide-zero-citations="true"
              data-style="small_rectangle"
              data-legend="hover-right"
              style="margin-bottom: 3px;"
            ></span>
          {% endif %}
          {% if site.enable_publication_badges.google_scholar and entry_has_google_scholar_badge %}
            <a
              href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user={{ site.scholar_userid }}&citation_for_view={{ site.scholar_userid }}:{{ entry.google_scholar_id }}"
              aria-label="Google Scholar link"
              role="button"
            >
              <img
                src="https://img.shields.io/badge/scholar-{% google_scholar_citations site.scholar_userid entry.google_scholar_id %}-4285F4?logo=googlescholar&labelColor=beige"
                alt="{% google_scholar_citations site.scholar_userid entry.google_scholar_id %} Google Scholar citations"
              >
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    {% if entry.award %}
      <!-- Hidden Award block -->
      <div id="{{ entry.key }}-award" class="award publication-detail hidden d-print-inline" aria-hidden="true">
        <p>{{ entry.award | markdownify }}</p>
      </div>
    {% endif %}

    {% if entry.abstract %}
      <!-- Hidden abstract block -->
      <div id="{{ entry.key }}-abstract" class="abstract publication-detail hidden" aria-hidden="true">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}

    {% if entry.bibtex_show %}
      <!-- Hidden bibtex block -->
      <div id="{{ entry.key }}-bibtex" class="bibtex publication-detail hidden" aria-hidden="true">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {% endif %}

    {% if entry.video and site.enable_video_embedding %}
      <!-- Hidden video block -->
      <div id="{{ entry.key }}-video" class="video publication-detail hidden" aria-hidden="true">
        <div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div>
      </div>
    {% endif %}
  </div>
  {% if entry_has_media %}
    <aside class="publication-media" aria-label="Publication details">
      {%- if entry.abbr -%}
        {%- if site.data.venues[entry.abbr] -%}
          <abbr class="publication-venue">
            {% if site.data.venues[entry.abbr].url %}
              <a href="{{site.data.venues[entry.abbr].url}}">{{ entry.abbr }}</a>
            {% else %}
              <span>{{- entry.abbr -}}</span>
            {% endif %}
          </abbr>
        {% else %}
          <abbr class="publication-venue">{{ entry.abbr }}</abbr>
        {% endif %}
      {% endif %}
      {% if entry.preview %}
        {% capture preview_alt %}Preview image for {{ entry.title | strip_html }}{% endcapture %}
        {% if entry.preview contains '://' %}
          <img class="preview" src="{{ entry.preview }}" alt="{{ preview_alt | strip | escape }}" loading="lazy">
        {% else %}
          {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
          {%
            include figure.liquid
            loading="lazy"
            path=entry_path
            sizes="(min-width: 576px) 160px, 80vw"
            class="preview"
            zoomable=true
            alt=preview_alt
          %}
        {% endif %}
      {% endif %}
    </aside>
  {% endif %}
  {% if page.presentation_bibliography %}
    {% if entry.preview %}
      <aside class="presentation-entry-aside" aria-label="Presentation preview">
        {% if entry.presentationtype %}
          <span class="presentation-type">{{ entry.presentationtype }}</span>
        {% endif %}
        <div class="presentation-preview">
          {% capture presentation_preview_alt %}Preview image for {{ entry.title | strip_html }}{% endcapture %}
          {% if entry.preview contains '://' %}
            <img class="preview" src="{{ entry.preview }}" alt="{{ presentation_preview_alt | strip | escape }}" loading="lazy">
          {% else %}
            {% assign presentation_entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
            {%
              include figure.liquid
              loading="lazy"
              path=presentation_entry_path
              sizes="(min-width: 576px) 160px, 80vw"
              class="preview"
              zoomable=true
              alt=presentation_preview_alt
            %}
          {% endif %}
        </div>
      </aside>
    {% endif %}
  {% endif %}
</article>
