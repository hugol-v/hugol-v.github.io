<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="news-panel{% if include.limit and site.announcements.scrollable and news_size > 3 %} news-panel--scrollable{% endif %}"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        role="region"
        aria-label="Recent news"
        tabindex="0"
      {% endif %}
    >
      {% assign news = site.news | reverse %}
      {% if include.limit and site.announcements.limit %}
        {% assign news_limit = site.announcements.limit %}
      {% else %}
        {% assign news_limit = news_size %}
      {% endif %}
      <ol class="news-list" role="list">
        {% for item in news limit: news_limit %}
          <li class="news-item">
            <time class="news-date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
            <div class="news-content">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
